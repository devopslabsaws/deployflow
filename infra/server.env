# DeployFlow — server .env for Azure VM
# Copy to ~/deployflow/.env on the server

SERVER_IP=20.83.147.234

# ── Oracle XE ────────────────────────────────────────────────────────────────
ORACLE_SYS_PASSWORD=DeployFlow_Sys_2024
ORACLE_APP_PASSWORD=DeployFlow_App_2024!

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=DeployFlow_Redis_2024!

# ── Auth / Encryption (generate with: openssl rand -base64 32) ───────────────
JWT_SECRET=CHANGE_ME_JWT_Secret_At_Least_32_Characters_Long_Replace_This
ENCRYPTION_SECRET=CHANGE_ME_Enc_Secret_At_Least_32_Characters_Long_Replace

# ── CORS (browser-facing URLs) ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://20.83.147.234,http://20.83.147.234:3000,http://20.83.147.234:5000

# ── Frontend build-time public vars ──────────────────────────────────────────
# These are baked into the JS bundle — use the server's public IP/domain
NEXT_PUBLIC_API_URL=http://20.83.147.234/api
NEXT_PUBLIC_WS_URL=ws://20.83.147.234/hubs
