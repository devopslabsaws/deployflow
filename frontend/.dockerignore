# Never include these in the Docker build context — they're platform-specific
# and will clobber the Linux modules installed inside the builder stage.
node_modules
.next

# Dev / test artefacts
*.log
*.txt
playwright-report/
test-results/

# Local env — secrets must not be baked into the image
.env
.env.local
.env.*.local

# Editor / OS noise
.DS_Store
*.swp
.vscode/
