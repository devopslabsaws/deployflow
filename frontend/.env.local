# Set to "true" to bypass all API calls and serve mock data locally.
# Remove or set to "false" when the backend is running.
NEXT_PUBLIC_USE_MOCK_API=false

# API base URL for browser requests.
# Leave NEXT_PUBLIC_API_URL *unset* (the default) so all requests are routed
# through the Next.js /proxy rewrite (server-side, no CORS, port-agnostic).
# Only set this if you need to point directly at a remote backend:
#   NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
