# DeployFlow Environment Variables
# Copy this file to .env and fill in your values before running

# ─── Docker Hub (for docker-compose.prod.yml) ────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# ─── Database (Oracle XE in Docker) ─────────────────────────────────────────
ORACLE_SYS_PASSWORD=change_this_sys_password
ORACLE_APP_PASSWORD=change_this_app_password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_this_strong_password_in_production

# ─── Security (REQUIRED — generate with: openssl rand -hex 32) ───────────────
JWT_SECRET=
ENCRYPTION_SECRET=

# ─── URLs ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000

# ─── TLS / Let's Encrypt (only needed when using Traefik profile) ─────────────
ACME_EMAIL=admin@example.com
